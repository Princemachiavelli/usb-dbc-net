+/*
+ * A device reset also resets the Debug Capability; a controller reset
+ * (USBCMD.HCRST) does not, as the DbC runs independently of the xHC.
+ */
+static void xhci_device_reset(DeviceState *dev)
+{
+    XHCIState *xhci = XHCI(dev);
+
+    xhci_reset(dev);
+    if (xhci->dbc_enabled) {
+        xhci_dbc_reset(xhci);
+    }
+}
+
 static void xhci_class_init(ObjectClass *klass, const void *data)
