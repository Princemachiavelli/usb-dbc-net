diff --git a/hw/usb/hcd-xhci.h b/hw/usb/hcd-xhci.h
index 5cb9e06d1..b257e8a36 100644
--- a/hw/usb/hcd-xhci.h
+++ b/hw/usb/hcd-xhci.h
@@ -172,6 +172,57 @@ typedef struct XHCIInterrupter {
 
 } XHCIInterrupter;
 
+/*
+ * Debug Capability (xHCI 1.2 section 7.6), placed in the reserved part of
+ * the operational register block so the extended capability chain can
+ * reach it from the Supported Protocol capabilities.
+ */
+#define XHCI_DBC_OFFSET 0x400
+#define XHCI_DBC_LEN    0x40
+
+/* DbC transfer rings, named as the target's driver sees them. */
+enum {
+    XHCI_DBC_OUT = 0,   /* target -> debug host, doorbell target 0 */
+    XHCI_DBC_IN  = 1,   /* debug host -> target, doorbell target 1 */
+};
+
+typedef struct XHCIDbCTRB {
+    bool valid;
+    dma_addr_t addr;    /* of the TRB itself, for its transfer event */
+    uint64_t buf;
+    uint32_t len;
+    uint32_t done;
+    uint32_t control;
+} XHCIDbCTRB;
+
+struct USBDbCPeer;
+
+typedef struct XHCIDbC {
+    MemoryRegion mem;
+
+    /* registers */
+    uint32_t erstsz;
+    uint64_t erstba;
+    uint64_t erdp;
+    uint32_t ctrl;
+    uint32_t portsc;
+    uint64_t dccp;
+    uint32_t ddi1;
+    uint32_t ddi2;
+
+    /* event ring */
+    dma_addr_t er_start;
+    uint32_t er_size;
+    uint32_t er_idx;
+    bool er_pcs;
+
+    XHCIRing ring[2];
+    XHCIDbCTRB trb[2];
+
+    /* the device end of the debug cable, if one is plugged in */
+    struct USBDbCPeer *peer;
+} XHCIDbC;
+
 typedef struct XHCIState {
     DeviceState parent;
 
@@ -223,9 +274,16 @@ typedef struct XHCIState {
     XHCIRing cmd_ring;
 
     bool nec_quirks;
+
+    bool dbc_enabled;   /* property "dbc" */
+    XHCIDbC dbc;
 } XHCIState;
 
 extern const VMStateDescription vmstate_xhci;
 bool xhci_get_flag(XHCIState *xhci, enum xhci_flags bit);
 void xhci_set_flag(XHCIState *xhci, enum xhci_flags bit);
+
+void xhci_dbc_realize(XHCIState *xhci, Error **errp);
+void xhci_dbc_unrealize(XHCIState *xhci);
+void xhci_dbc_reset(XHCIState *xhci);
 #endif
